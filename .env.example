# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
# Local: http://localhost:3000 | Produção: https://tibiaplace.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible) — fotos extras de listings (UI desativada)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tibiaplace
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Cloudinary — cache persistente de sprites outfit/mount
# Opção A: três variáveis separadas
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opção B: URL única do dashboard (cloudinary://key:secret@cloud_name)
# CLOUDINARY_URL=

# App (mesma URL pública do BETTER_AUTH_URL em produção)
NEXT_PUBLIC_APP_URL=http://localhost:3000
WHATSAPP_NUMBER=5511999999999

# Conta mestra (única) — rode: npm run admin:ensure-master
MASTER_ADMIN_EMAIL=admin@tibiaplace.com.br
MASTER_ADMIN_PASSWORD=troque-esta-senha
MASTER_ADMIN_NAME=Admin
